#version 460
#extension GL_EXT_mesh_shader : require
// Task index route feature: a 2D Mesh workgroup (32x4).
layout(local_size_x=32, local_size_y=4) in;
layout(triangles, max_vertices=128, max_primitives=64) out;
layout(location=0) perprimitiveEXT flat out vec4 pcol[];
struct P { uint base; }; taskPayloadSharedEXT P pl;
void main(){
 uint i=gl_LocalInvocationIndex;
 SetMeshOutputsEXT(128,64);
 gl_MeshVerticesEXT[i].gl_Position=vec4(float(gl_LocalInvocationID.x)/16.0-1.0,float(gl_LocalInvocationID.y)/2.0-1.0,0.5,1);
 if(i<64u){ gl_PrimitiveTriangleIndicesEXT[i]=uvec3(i,(i+1u)%128u,(i+2u)%128u); pcol[i]=vec4(float(pl.base),0,1,1); }
}
